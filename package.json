{
  "name": "interpreter",
  "version": "0.1.24",
  "internalVersion": "0.2.171",
  "publicVersion": "0.2.183",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openinterpreter/interpreter-workstation.git"
  },
  "description": "The desktop agent for knowledge work",
  "author": {
    "name": "Open Interpreter",
    "email": "help@openinterpreter.com"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9 <10"
  },
  "main": "dist-electron/electron/main.cjs",
  "exports": {
    ".": {
      "import": "./dist-electron/electron/main.cjs",
      "require": "./dist-electron/electron/main.cjs"
    },
    "./tests": {
      "import": "./tests/index.ts",
      "types": "./tests/index.ts"
    }
  },
  "scripts": {
    "dev": "node scripts/build-with-lock.cjs --dev && node scripts/dev-stack.cjs",
    "dev:browser": "cross-env BROWSER_DEV=true pnpm run dev",
    "dev:extension": "pnpm run extension:watch",
    "dev:stream": " pnpm run dev 2>&1 | tee output.log",
    "dev:vite": "vite",
    "dev:electron": "node scripts/dev-electron.cjs",
    "workspace:status": "node scripts/switch-platform-workspace.mjs status",
    "workspace:use": "node scripts/switch-platform-workspace.mjs",
    "workspace:use:mac": "node scripts/switch-platform-workspace.mjs mac",
    "workspace:use:windows": "node scripts/switch-platform-workspace.mjs windows",
    "workspace:use:linux": "node scripts/switch-platform-workspace.mjs linux",
    "winvm:ps": "node scripts/windows-vm-shell.mjs --shell powershell",
    "winvm:cmd": "node scripts/windows-vm-shell.mjs --shell cmd",
    "winvm:workspace:status": "node scripts/windows-vm-workspace.mjs status",
    "winvm:sync-source": "node scripts/windows-vm-workspace.mjs sync",
    "winvm:install": "node scripts/windows-vm-workspace.mjs install",
    "winvm:workspace:run": "node scripts/windows-vm-workspace.mjs run",
    "winvm:test:smoke": "node scripts/windows-vm-workspace.mjs test:smoke",
    "winvm:test:voice": "node scripts/windows-vm-workspace.mjs test:voice",
    "marketing-demo:dev": "cross-env VITE_INTERPRETER_MARKETING_DEMO=1 vite --config apps/interpreter-marketing-demo/vite.config.ts",
    "marketing-demo:build": "cross-env VITE_INTERPRETER_MARKETING_DEMO=1 vite build --config apps/interpreter-marketing-demo/vite.config.ts",
    "marketing-demo:preview": "cross-env VITE_INTERPRETER_MARKETING_DEMO=1 vite preview --config apps/interpreter-marketing-demo/vite.config.ts --host 127.0.0.1 --port 4174",
    "dev:clean": "echo y | pnpm reset-config --hard && pnpm run dev",
    "dev:no-hmr": "cross-env VITE_ENABLE_DEV_VIDEO_TOOLING=1 pnpm run build && cross-env INTERPRETER_USE_BUILT_RENDERER=true node scripts/run-unpackaged-electron.cjs",
    "dev:local": "cross-env USE_LOCAL_API=true pnpm run dev",
    "overlay:debug": "node scripts/interpreter-overlay-debug.mjs",
    "overlay:visualize": "node scripts/interpreter-overlay-debug.mjs visualize",
    "agent:log": "node scripts/render-agent-log.mjs",
    "browser-form-tests:auto": "node browser-form-tests/main.cjs",
    "browser-page-tools:smoke": "node scripts/browser-page-tools-cli-smoke.cjs",
    "browser-page-tools:smoke:negative": "node scripts/browser-page-tools-cli-smoke.cjs --negative",
    "build": "pnpm run ensure:js-repl-runtime-assets && pnpm run ensure:browser-extension-relay-assets && pnpm run build:renderer && pnpm run build:electron",
    "build:community": "pnpm run build",
    "build:official": "node scripts/with-distribution-config.mjs distribution/product.official.json -- pnpm run build",
    "build:dev-prep": "pnpm run ensure:js-repl-runtime-assets && pnpm run ensure:browser-extension-relay-assets && pnpm run build:electron",
    "build:locked": "node scripts/build-with-lock.cjs",
    "build:renderer": "cross-env NODE_ENV=production vite build",
    "build:electron": "cross-env NODE_ENV=production node build-electron.mjs",
    "ensure:codex-generated-types": "node scripts/ensure-codex-generated-types.mjs",
    "download:oix": "node scripts/download-oix.mjs",
    "download:pdfcpu": "node scripts/download-pdfcpu.mjs",
    "download:qwen-asr": "node scripts/download-qwen-asr.mjs",
    "test:qwen-download-contract": "node --test scripts/download-qwen-asr.test.mjs",
    "install:qwen-asr-model": "node scripts/install-qwen-asr-runtime-model.mjs",
    "build:js-repl-runtime": "node scripts/build-js-repl-runtime.mjs",
    "ensure:js-repl-runtime-assets": "node scripts/ensure-js-repl-runtime-assets.mjs",
    "build:browser-extension-relay-runtime": "node scripts/build-browser-extension-relay-runtime.mjs",
    "ensure:browser-extension-relay-assets": "node scripts/ensure-browser-extension-relay-assets.mjs",
    "extension:bootstrap": "git submodule update --init --recursive apps/interpreter-extension && cross-env NODE_ENV=development pnpm --dir apps/interpreter-extension run bootstrap",
    "extension:assets": "node scripts/build-browser-extension-brand-assets.mjs",
    "extension:build": "node -e \"const fs=require('node:fs');const p='apps/interpreter-extension/playwriter/shell-emulator-placeholder.tsbuildinfo';if(!fs.existsSync(p))fs.writeFileSync(p,'');\" && pnpm --config.shell-emulator=true --dir apps/interpreter-extension run build",
    "extension:watch": "pnpm --dir apps/interpreter-extension run watch",
    "extension:reload": "pnpm --dir apps/interpreter-extension run reload",
    "extension:browser:start": "pnpm --dir apps/interpreter-extension run cli -- browser start",
    "extension:upstream:fetch": "node scripts/ensure-interpreter-extension-upstream-remote.mjs --fetch",
    "extension:test": "pnpm --dir apps/interpreter-extension run test",
    "extension:test:integration": "pnpm --dir apps/interpreter-extension --filter playwriter exec vitest run src/browser-access-policy.test.ts src/extension-connection.test.ts src/relay-navigation.test.ts",
    "extension:test:integration:full": "pnpm --dir apps/interpreter-extension --filter playwriter exec vitest run src/extension-connection.test.ts src/relay-core.test.ts src/relay-navigation.test.ts src/relay-session.test.ts src/relay-state.test.ts test/security.test.ts",
    "extension:verify": "pnpm run extension:build && pnpm run ensure:browser-extension-relay-assets && pnpm run extension:test:integration",
    "trycua:update": "node scripts/update-trycua-cua.mjs",
    "generate:model-catalog": "bun scripts/generate-model-catalog.ts",
    "build:dist": "pnpm run download:oix -- --current-platform && pnpm run download:pdfcpu -- --current-platform && pnpm run download:qwen-asr -- --current-platform && pnpm run build:js-repl-runtime && pnpm run build && electron-builder",
    "package:smoke": "node scripts/package-smoke.mjs",
    "package:smoke:official": "node scripts/with-distribution-config.mjs distribution/product.official.json -- pnpm run package:smoke",
    "package:official": "node scripts/with-distribution-config.mjs distribution/product.official.json -- pnpm run build:dist --config distribution/electron-builder.official.yml",
    "package:official:candidate:mac-arm64": "PYTHON=/usr/bin/python3 CSC_IDENTITY_AUTO_DISCOVERY=false node scripts/with-distribution-config.mjs distribution/product.official.json -- pnpm run build:dist --config distribution/electron-builder.official-candidate.yml --mac dmg zip --arm64 --publish never",
    "package:internal:mac-arm64": "PYTHON=/usr/bin/python3 CSC_IDENTITY_AUTO_DISCOVERY=false node scripts/with-distribution-config.mjs distribution/product.official.json -- pnpm run build:dist --config distribution/electron-builder.internal.yml --mac dmg zip --arm64 --publish never",
    "release:verify:official-candidate": "node scripts/verify-official-release-candidate.mjs",
    "release:verify:internal": "node scripts/verify-internal-release.mjs",
    "start": "node scripts/run-unpackaged-electron.cjs",
    "test": "pnpm run test:unit && pnpm run test:vitest && pnpm run test:e2e:ci",
    "test:voice": "pnpm run test:unit:voice && pnpm run test:e2e:voice:ci",
    "test:transcribe": "bun test server/tools/builtin-tools/transcribe/transcribeTools.live.test.ts",
    "test:cua": "node scripts/cua-test-suite.mjs",
    "test:cua:agent:web": "tsx scripts/macos-cua-agent-chrome-web-form-smoke.ts",
    "test:mac-cua-driver": "tsx scripts/macos-cua-driver-native-form-cli-smoke.ts",
    "test:mac-desktop-permissions": "tsx scripts/macos-cua-driver-permissions-flow-smoke.ts",
    "test:mac-installed-desktop-permissions": "tsx scripts/macos-installed-electron-desktop-permissions-smoke.ts",
    "test:win-cua-chromium": "tsx scripts/windows-cua-chromium-background-smoke.ts",
    "test:win-cua-agent-calculator": "tsx scripts/windows-cua-agent-calculator-smoke.ts",
    "test:win-cua-driver": "tsx scripts/windows-cua-driver-background-smoke.ts",
    "test:win-cua-calculator": "tsx scripts/windows-cua-calculator-smoke.ts",
    "test:e2e": "pnpm run test:e2e:ci",
    "test:electron:ready": "node scripts/ensure-test-electron.mjs",
    "test:e2e:ci": "pnpm run build:locked && pnpm run test:electron:ready && cross-env NODE_ENV=test playwright test --project=smoke --project=deterministic",
    "test:e2e:permissions:ci": "pnpm run build:locked && pnpm run test:electron:ready && cross-env NODE_ENV=test playwright test tests/agent-file-permissions.spec.ts --project=deterministic",
    "test:e2e:hosted:ci": "pnpm run build:locked && pnpm run test:electron:ready && cross-env NODE_ENV=test playwright test --project=external",
    "test:e2e:media-ai:local": "pnpm run build:locked && pnpm run test:electron:ready && cross-env NODE_ENV=test USE_LOCAL_API=true RUN_MEDIA_AI_E2E=true INTERPRETER_SKIP_TEST_ELECTRON_REBUILD=1 playwright test tests/media-ai-gpt-image-2.spec.ts --project=external",
    "test:e2e:hosted:permissions:ci": "pnpm run build:locked && pnpm run test:electron:ready && cross-env NODE_ENV=test playwright test tests/agent-shell-permissions.spec.ts --project=external",
    "test:e2e:smoke": "pnpm run build:locked && pnpm run test:electron:ready && cross-env NODE_ENV=test playwright test --project=smoke",
    "test:e2e:voice": "pnpm run test:e2e:voice:ci",
    "test:e2e:voice:ci": "pnpm run build:locked && pnpm run test:electron:ready && node scripts/check-voice-test-prereqs.mjs && cross-env NODE_ENV=test playwright test --project=voice-deterministic",
    "test:e2e:nightly": "pnpm run build:locked && pnpm run test:electron:ready && cross-env NODE_ENV=test playwright test --project=smoke --project=deterministic --project=nightly --project=external --project=voice-deterministic --project=voice-live",
    "test:local": "pnpm run build:locked && pnpm run test:electron:ready && cross-env NODE_ENV=test USE_LOCAL_API=true playwright test --project=smoke",
    "test:local:voice": "pnpm run build:locked && pnpm run test:electron:ready && node scripts/check-voice-test-prereqs.mjs && cross-env NODE_ENV=test USE_LOCAL_API=true playwright test --project=voice-deterministic",
    "test:movie": "bun test server/handlers/movie.test.ts && pnpm run build:locked && pnpm run test:electron:ready && cross-env NODE_ENV=test playwright test tests/movie-editor.spec.ts",
    "test:agent": "playwright test agent.spec.ts",
    "test:tools": "playwright test tools-",
    "test:interpreter:smoke": "node scripts/check-interpreter-cli-smoke.mjs",
    "test:pdf:integration": "electron scripts/pdf-integration-smoke.mjs",
    "test:pdf:integration:open": "electron scripts/pdf-integration-smoke.mjs --open",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:unit:voice": "node scripts/run-voice-unit-tests.mjs",
    "test:vitest": "pnpm exec vitest run --config vitest.config.ts",
    "test:vitest:watch": "pnpm exec vitest --config vitest.config.ts",
    "test:live:ollama": "bun test src/lib/codex/ollama.live.test.ts",
    "test:live:lmstudio": "bun test src/lib/codex/lmstudio.live.test.ts",
    "test:coverage": "playwright test --grep-invert @voice && open tests/coverage-report/index.html",
    "install:all": "pnpm install",
    "typecheck": "pnpm run ensure:codex-generated-types && tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "precommit": "pnpm run typecheck && pnpm run test:unit && pnpm run test:vitest",
    "release:licenses": "pnpm licenses list --prod --json",
    "release:licenses:check": "node scripts/check-production-licenses.mjs",
    "fixtures:generate": "node scripts/generate-public-test-fixtures.mjs",
    "lint:selectors": "npx tsx scripts/lint-selectors.ts",
    "lint": "pnpm run typecheck && pnpm run lint:selectors",
    "check:react-compiler": "cross-env REACT_COMPILER_PANIC_THRESHOLD=all_errors pnpm run build:renderer",
    "schema:validators": "bun run src/lib/validators/compile.ts",
    "sidecar": "bun server/standalone.ts",
    "sidecar:node": "npx tsx server/standalone.ts",
    "sidecar:cua-driver": "npx tsx server/standalone.ts",
    "sidecar:tools:auto-approve": "npx tsx server/standalone.ts --dev-auto-approve-tools",
    "headless": "bun server/standalone.ts",
    "headless:node": "npx tsx server/standalone.ts",
    "dev:local:cua-driver": "pnpm run dev:local",
    "reset-config": "npx tsx scripts/reset-config.ts",
    "postinstall": "node -e \"if(!process.env.CI){require('child_process').execSync('electron-rebuild -f -w node-pty,uiohook-napi,interpreter-window-pin',{stdio:'inherit'})}\"",
    "verify:openai-key": "node scripts/verify-openai-realtime-key.mjs"
  },
