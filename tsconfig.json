{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "agent/**/*", "tests/**/*", "shared/**/*", "apps/interpreter-overlay/renderer/**/*", "apps/interpreter-overlay/shared/**/*"],
  "exclude": ["src/lib/react-arborist/**/*", "**/*.test.ts", "**/*.demo.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
